    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "labels": {
          "app": "db-backup"
        },
        "name": "db-backup",
        "namespace": "jt-drupal-stage"
      },
      "spec": {
        "concurrencyPolicy": "Forbid",
        "failedJobsHistoryLimit": 3,
        "jobTemplate": {
          "metadata": {},
          "spec": {
            "activeDeadlineSeconds": 1800,
            "backoffLimit": 1,
            "template": {
              "metadata": {
                "labels": {
                  "app": "db-backup",
                  "job": "db-backup"
                }
              },
              "spec": {
                "containers": [
                  {
                    "command": [
                      "sh",
                      "-c",
                      "set -eu\n\n# healthchecks.io dead-man's-switch (optional: pings are skipped\n# if the secret/URL isn't present, backup still runs)\nHC=\"\"\n[ -s /hc/url ] && HC=\"$(tr -d '[:space:]' < /hc/url)\"\nping() { [ -n \"$HC\" ] && curl -fsS -m 10 --retry 3 \"$HC$1\" >/dev/null 2>&1 || true; }\n\nping /start\n\nKEY=\"s3://amazon-jtarleton-s3/s3fs-private/mariadb-dumps/jt-drupal-db_full_$(date +%Y%m%d-%H%M%S).sql.gz\"\nif [ -s /backup/dump.sql.gz ] \\\n   && [ \"$(wc -c < /backup/dump.sql.gz)\" -ge \"$MIN_BYTES\" ] \\\n   && aws s3 cp /backup/dump.sql.gz \"$KEY\" --only-show-errors; then\n  echo \"uploaded $KEY ($(wc -c < /backup/dump.sql.gz) bytes)\"\n  ping \"\"\nelse\n  echo \"backup FAILED (missing / too small / upload error)\" >&2\n  ping /fail\n  exit 1\nfi\n"
                    ],
                    "env": [
                      {
                        "name": "AWS_DEFAULT_REGION",
                        "value": "us-east-1"
                      },
                      {
                        "name": "HOME",
                        "value": "/root"
                      },
                      {
                        "name": "MIN_BYTES",
                        "value": "1000000"
                      }
                    ],
                    "image": "amazon/aws-cli:latest",
                    "imagePullPolicy": "Always",
                    "name": "upload",
                    "resources": {},
                    "terminationMessagePath": "/dev/termination-log",
                    "terminationMessagePolicy": "File",
                    "volumeMounts": [
                      {
                        "mountPath": "/backup",
                        "name": "backup"
                      },
                      {
                        "mountPath": "/root/.aws",
                        "name": "aws-creds",
                        "readOnly": true
                      },
                      {
                        "mountPath": "/hc",
                        "name": "healthchecks",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "dnsPolicy": "ClusterFirst",
                "initContainers": [
                  {
                    "command": [
                      "sh",
                      "-c",
                      "set -e\nmariadb-dump -h db -uroot -p\"$MARIADB_ROOT_PASSWORD\" \\\n  --all-databases --single-transaction --routines --triggers --events \\\n  | gzip -9 > /backup/dump.sql.gz\n"
                    ],
                    "envFrom": [
                      {
                        "secretRef": {
                          "name": "db-credentials"
                        }
                      }
                    ],
                    "image": "mariadb:latest",
                    "imagePullPolicy": "Always",
                    "name": "dump",
                    "resources": {},
                    "terminationMessagePath": "/dev/termination-log",
                    "terminationMessagePolicy": "File",
                    "volumeMounts": [
                      {
                        "mountPath": "/backup",
                        "name": "backup"
                      }
                    ]
                  }
                ],
                "restartPolicy": "Never",
                "schedulerName": "default-scheduler",
                "securityContext": {},
                "terminationGracePeriodSeconds": 30,
                "volumes": [
                  {
                    "emptyDir": {},
                    "name": "backup"
                  },
                  {
                    "name": "aws-creds",
                    "secret": {
                      "defaultMode": 420,
                      "secretName": "aws-backup-credentials"
                    }
                  },
                  {
                    "name": "healthchecks",
                    "secret": {
                      "defaultMode": 420,
                      "optional": true,
                      "secretName": "healthchecks-db-backup"
                    }
                  }
                ]
              }
            }
          }
        },
        "schedule": "30 2 * * *",
        "successfulJobsHistoryLimit": 3,
        "suspend": false
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
